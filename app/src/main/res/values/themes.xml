<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme for Phone/Tablet -->
    <style name="Theme.UnifiedCinema" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/purple_700</item>
        <item name="colorPrimaryContainer">@color/purple_200</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorOnPrimaryContainer">@color/black</item>
        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryContainer">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorOnSecondaryContainer">@color/white</item>
        <!-- Tertiary -->
        <item name="colorTertiary">@color/purple_200</item>
        <item name="colorTertiaryContainer">@color/purple_700</item>
        <item name="colorOnTertiary">@color/black</item>
        <item name="colorOnTertiaryContainer">@color/white</item>
        <!-- Surface -->
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/white</item>
        <!-- Background -->
        <item name="colorBackground">@color/background_dark</item>
        <item name="colorOnBackground">@color/white</item>
        <!-- Error -->
        <item name="colorError">#FFCF6679</item>
        <item name="colorOnError">@color/black</item>
        <!-- Status bar color -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- Window background -->
        <item name="android:windowBackground">@color/background_dark</item>
    </style>

    <!-- Theme for Android TV -->
    <style name="Theme.UnifiedCinema.TV" parent="Theme.Leanback">
        <item name="colorPrimary">@color/purple_700</item>
        <item name="colorPrimaryContainer">@color/purple_200</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorOnPrimaryContainer">@color/black</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryContainer">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorOnSecondaryContainer">@color/white</item>
        <item name="android:windowBackground">@color/background_dark</item>
    </style>

    <!-- Theme for Video Player (Fullscreen) -->
    <style name="Theme.UnifiedCinema.Player" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>